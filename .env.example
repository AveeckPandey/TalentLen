# =================================================================
# Candidate Screening System Configuration
# =================================================================

# GitHub Token (Optional, recommended for large batches to avoid 60 req/hr rate limits)
# Create a free personal access token at https://github.com/settings/tokens (no special scopes needed for public data)
GITHUB_TOKEN=

# LLM Provider Configuration (Optional)
# Supported options: "auto", "groq", "openai", "gemini", "anthropic", "heuristic"
# If no API key is provided, the system seamlessly uses a high-precision deterministic heuristic engine.
LLM_PROVIDER=auto

# Groq Configuration (Optional, OpenAI-compatible — Qwen, Llama, etc.)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Configuration (Optional, Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Execution Settings
CONCURRENCY_LIMIT=5
DEFAULT_INPUT_DIR=./resumes
DEFAULT_OUTPUT_FILE=./output/results.json

# Supabase Auth (Phase 1 — optional for local dev, required for Render prod)
# Dashboard > Project Settings > API + Authentication > Providers.
# New-style keys: sb_publishable_... (frontend) + sb_secret_... (backend only).
# Legacy keys (anon/service_role + JWT secret) also work if you still have them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Legacy (optional fallback):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_JWT_SECRET=
# Optional direct Postgres for Phase 2 jobs tables:
# DATABASE_URL=postgresql://postgres:***@db.<ref>.supabase.co:5432/postgres
# Set true on Render once Supabase is configured to force login:
REQUIRE_AUTH=false
