# Kasparro frontend (Next.js) — talks to the FastAPI backend
# Local dev: Next.js on :3000 proxies API paths to FastAPI on :8000 (see next.config.mjs rewrites).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-side rewrite target (used by next dev / next start):
API_URL=http://127.0.0.1:8000

# Optional Supabase Auth (mirrors root .env). Leave blank for local dev (auth bypassed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
